  BranchFocusArea  BranchFocusArea[]
}

model BranchFocusArea {
  id           Int      @id @default(autoincrement())
  orgUnitId    Int
  focusAreaId  Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  FocusArea    FocusArea @relation(fields: [focusAreaId], references: [id], onDelete: Cascade)
  OrgUnit      OrgUnit   @relation("BranchFocusAreas", fields: [orgUnitId], references: [id], onDelete: Cascade)

  @@unique([orgUnitId, focusAreaId])
