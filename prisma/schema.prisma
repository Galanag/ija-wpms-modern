  Report_Report_submittedByToUser       Report[]             @relation("Report_submittedByToUser")
  Session                               Session[]
  Setting                               Setting[]
   SourceReference                         SourceReference[]
   TaskUpdate                            TaskUpdate[]
  Employee                              Employee?            @relation(fields: [employeeId], references: [id])
  OrgUnit                               OrgUnit?             @relation(fields: [primaryOrgUnitId], references: [id])
  Role                                  Role                 @relation(fields: [roleId], references: [id])
  UserModuleAccess                      UserModuleAccess[]
}

model UserModuleAccess {
  userId Int
  module String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
}

model BudgetCategory {
  id          Int     @id @default(autoincrement())
  code        String?
  name        String
  description String?
  active      Boolean @default(true)
}

model FundingSource {
  id          Int     @id @default(autoincrement())
  code        String? @unique
  name        String
  type        String  @default("government")
  description String?
  active      Boolean @default(true)

  @@index([active])
}

model RolloverJob {
  id            Int            @id @default(autoincrement())
  sourceYearId  Int
  targetYearId  Int
  status        String         @default("preview")
  mode          String         @default("all")
  selection     Json?
  preview       Json?
  summary       Json?
  createdBy     Int?
  createdByName String?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         RolloverItem[]
  sourceYear    PlanningYear   @relation("RolloverJob_sourceYearIdToPlanningYear", fields: [sourceYearId], references: [id])
  targetYear    PlanningYear   @relation("RolloverJob_targetYearIdToPlanningYear", fields: [targetYearId], references: [id])

  @@unique([sourceYearId, targetYearId, mode])
  @@index([sourceYearId])
  @@index([targetYearId])
  @@index([status])
}

model RolloverItem {
  id           Int         @id @default(autoincrement())
  jobId        Int
  itemKey      String
  sourceId     Int
  targetId     Int?
  sourceYearId Int
  targetYearId Int
  status       String      @default("pending")
  copiedData   Json?
  error        String?
  copiedAt     DateTime?
  RolloverJob  RolloverJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, itemKey, sourceId])
  @@unique([sourceYearId, targetYearId, itemKey, sourceId])
  @@index([itemKey])
  @@index([sourceYearId, targetYearId])
}

model KpiTemplate {
  id         Int          @id @default(autoincrement())
  code       String       @unique
  name       String
  area       String?
  definition String?
  formula    String?
  unit       String?
  frequency  String       @default("quarterly")
  direction  String       @default("higher_is_better")
  categoryId Int?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  kpiPlans   KpiPlan[]
  category   KpiCategory? @relation(fields: [categoryId], references: [id])

  @@index([active])
  @@index([categoryId])
}

model WorkPlan {
  id             Int          @id @default(autoincrement())
  yearId         Int
  orgUnitId      Int?
  ownerId        Int?
  name           String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  status         String       @default("draft")
  approvalStatus String       @default("draft")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      Int?
  updatedBy      Int?
  Activity       Activity[]
  OrgUnit        OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  PlanningYear   PlanningYear @relation(fields: [yearId], references: [id])

  @@index([yearId])
  @@index([orgUnitId])
  @@index([ownerId])
}

model SubTask {
  id            Int       @id @default(autoincrement())
  activityId    Int
  title         String
  description   String?
  employeeId    Int?
  startDate     DateTime?
  endDate       DateTime?
  progress      Float     @default(0)
  status        String    @default("pending")
  orderIndex    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedDate DateTime?
  Activity      Activity  @relation(fields: [activityId], references: [id])
  Employee      Employee? @relation(fields: [employeeId], references: [id])

  @@index([activityId])
  @@index([employeeId])
}

model Deliverable {
  id            Int       @id @default(autoincrement())
  activityId    Int
  title         String
