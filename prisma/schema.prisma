model CurrencyRate {
  id                                             Int      @id @default(autoincrement())
  fromcurrencyid                                 Int
  tocurrencyid                                   Int
  rate                                           Decimal  @default(1) @db.Decimal(18, 6)
  effectivedate                                  DateTime @default(now()) @db.Timestamp(6)
  createdat                                      DateTime @default(now()) @db.Timestamp(6)
  updatedat                                      DateTime @default(now()) @db.Timestamp(6)
  Currency_CurrencyRate_fromcurrencyidToCurrency Currency @relation("CurrencyRate_fromcurrencyidToCurrency", fields: [fromcurrencyid], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Currency_CurrencyRate_tocurrencyidToCurrency   Currency @relation("CurrencyRate_tocurrencyidToCurrency", fields: [tocurrencyid], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([fromcurrencyid, tocurrencyid, effectivedate])
}

model FocusArea {
  id               Int              @id @default(autoincrement())
  code             String           @unique @db.VarChar(20)
  name             String           @db.VarChar(100)
