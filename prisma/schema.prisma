model DataImportJob {
  id          Int       @id @default(autoincrement())
  entityType  String
  fileName    String
  totalRows   Int       @default(0)
  successRows Int       @default(0)
  failedRows  Int       @default(0)
  status      String    @default("pending")
  errors      Json?
