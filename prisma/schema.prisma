generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id                                        Int                    @id @default(autoincrement())
  yearId                                    Int
  objectiveId                               Int?
  projectId                                 Int?
  orgUnitId                                 Int?
  branchOrgUnitId                           Int?
  employeeId                                Int?
  code                                      String?
  title                                     String
  description                               String?
  quarter                                   String?
  startDate                                 DateTime?
  dueDate                                   DateTime?
  progress                                  Float                  @default(0)
  implementationStatus                      String                 @default("not_started")
  approvalStatus                            String                 @default("draft")
  budget                                    Decimal                @default(0) @db.Decimal(18, 2)
  weight                                    Float                  @default(1)
  activityTemplateId                        Int?
  workPlanId                                Int?
  completedDate                             DateTime?
  plannedQuantity                           Float?
  actualQuantity                            Float?
  unit                                      String?
  priority                                  String                 @default("medium")
  ActivityTemplate                          ActivityTemplate?      @relation(fields: [activityTemplateId], references: [id])
  OrgUnit_Activity_branchOrgUnitIdToOrgUnit OrgUnit?               @relation("Activity_branchOrgUnitIdToOrgUnit", fields: [branchOrgUnitId], references: [id])
  Employee                                  Employee?              @relation(fields: [employeeId], references: [id])
  Objective                                 Objective?             @relation(fields: [objectiveId], references: [id])
  OrgUnit_Activity_orgUnitIdToOrgUnit       OrgUnit?               @relation("Activity_orgUnitIdToOrgUnit", fields: [orgUnitId], references: [id])
  Project                                   Project?               @relation(fields: [projectId], references: [id])
  WorkPlan                                  WorkPlan?              @relation(fields: [workPlanId], references: [id])
  PlanningYear                              PlanningYear           @relation(fields: [yearId], references: [id], onDelete: Cascade)
  BudgetRequest                             BudgetRequest[]
  Deliverable                               Deliverable[]
  EmployeePlanActivity                      EmployeePlanActivity[]
  MonitoringVisit                           MonitoringVisit[]
  SubTask                                   SubTask[]
  TaskUpdate                                TaskUpdate[]

  @@index([yearId, orgUnitId, branchOrgUnitId])
  @@index([workPlanId])
  @@index([activityTemplateId])
}

model AnnualPlanAllocation {
  id               Int          @id @default(autoincrement())
  yearId           Int
  orgUnitId        Int?
  name             String
  allocationAmount Decimal      @default(0) @db.Decimal(18, 2)
  notes            String?
  approvalStatus   String       @default("draft")
  currencyid       Int?
  Currency         Currency?    @relation(fields: [currencyid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrgUnit          OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  PlanningYear     PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
  Budget           Budget[]
}

model AnnualPlanRevision {
  id           Int          @id @default(autoincrement())
  yearId       Int
  versionNo    Int
  reason       String?
  createdBy    Int?
  createdAt    DateTime     @default(now())
  status       String       @default("draft")
  User         User?        @relation(fields: [createdBy], references: [id])
  PlanningYear PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@unique([yearId, versionNo])
}

model Approval {
  id                              Int           @id @default(autoincrement())
  yearId                          Int?
  entityType                      String
  entityId                        Int
  stepNo                          Int
  stepName                        String
  requiredRole                    String
  status                          String        @default("pending")
  requestedBy                     Int?
  decidedBy                       Int?
  decision                        String?
  comment                         String?
  requestedAt                     DateTime      @default(now())
  decidedAt                       DateTime?
  User_Approval_decidedByToUser   User?         @relation("Approval_decidedByToUser", fields: [decidedBy], references: [id])
  User_Approval_requestedByToUser User?         @relation("Approval_requestedByToUser", fields: [requestedBy], references: [id])
  PlanningYear                    PlanningYear? @relation(fields: [yearId], references: [id])

  @@index([entityType, entityId, status])
}

model Asset {
  id                  Int            @id @default(autoincrement())
  assetNo             String?        @unique
  assetName           String
  categoryId          Int?
  acquisitionDate     DateTime?
  acquisitionCost     Decimal        @default(0) @db.Decimal(18, 2)
  status              String         @default("active")
  orgUnitId           Int?
  custodianEmployeeId Int?
  location            String?
  AssetCategory       AssetCategory? @relation(fields: [categoryId], references: [id])
  Employee            Employee?      @relation(fields: [custodianEmployeeId], references: [id])
  OrgUnit             OrgUnit?       @relation(fields: [orgUnitId], references: [id])
}

model AssetCategory {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)
  Asset  Asset[]
}

model Attachment {
  id           Int      @id @default(autoincrement())
  entityType   String
  entityId     Int
  purpose      String?
  filename     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  note         String?
  createdBy    Int?
  createdAt    DateTime @default(now())
  User         User?    @relation(fields: [createdBy], references: [id])

  @@index([entityType, entityId])
}

model Audit {
  id           Int            @id @default(autoincrement())
  yearId       Int
  auditType    String
  title        String
  orgUnitId    Int?
  plannedDate  DateTime?
  actualDate   DateTime?
  status       String         @default("planned")
  OrgUnit      OrgUnit?       @relation(fields: [orgUnitId], references: [id])
  PlanningYear PlanningYear   @relation(fields: [yearId], references: [id], onDelete: Cascade)
  AuditFinding AuditFinding[]
}

model AuditFinding {
  id                   Int       @id @default(autoincrement())
  auditId              Int
  finding              String
  severity             String    @default("medium")
  recommendation       String?
  responsibleOrgUnitId Int?
  dueDate              DateTime?
  status               String    @default("open")
  Audit                Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  OrgUnit              OrgUnit?  @relation(fields: [responsibleOrgUnitId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  recordId  String?
  createdAt DateTime @default(now())
  oldValue  String?
  newValue  String?
  ipAddress String?
  userAgent String?
  metadata  String?
  User      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entity, recordId])
  @@index([userId])
  @@index([entity, recordId], map: "AuditLog_entityType_entityId_idx")
}

model Currency {
  id                                                 Int                    @id @default(autoincrement())
  code                                               String                 @unique @db.VarChar(3)
  name                                               String                 @db.VarChar(100)
  symbol                                             String                 @default("") @db.VarChar(10)
  decimalPlaces                                      Int                    @default(2) @map("decimalplaces")
  locale                                             String                 @default("en-US") @db.VarChar(20)
  isActive                                           Boolean                @default(true) @map("isactive")
  isDefault                                          Boolean                @default(false) @map("isdefault")
  createdAt                                          DateTime               @default(now()) @map("createdat") @db.Timestamp(6)
  updatedAt                                          DateTime               @default(now()) @updatedAt @map("updatedat") @db.Timestamp(6)
  AnnualPlanAllocation                               AnnualPlanAllocation[]
  Budget                                             Budget[]
  BudgetLine                                         BudgetLine[]
  BudgetRequest                                      BudgetRequest[]
  CurrencyRate_CurrencyRate_fromcurrencyidToCurrency CurrencyRate[]         @relation("CurrencyRate_fromcurrencyidToCurrency")
  CurrencyRate_CurrencyRate_tocurrencyidToCurrency   CurrencyRate[]         @relation("CurrencyRate_tocurrencyidToCurrency")
  FinanceEntry                                       FinanceEntry[]
  KpiActual                                          KpiActual[]
  KpiPlan                                            KpiPlan[]
  PlanningYear                                       PlanningYear[]
  Project                                            Project[]
}

model Budget {
  id                   Int                   @id @default(autoincrement())
  yearId               Int
  planAllocationId     Int?
  orgUnitId            Int?
  category             String
  plannedAmount        Decimal               @default(0) @db.Decimal(18, 2)
  revisedAmount        Decimal               @default(0) @db.Decimal(18, 2)
  approvalStatus       String                @default("draft")
  currencyId           Int                   @default(1) @map("currencyid")
  currency             Currency              @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrgUnit              OrgUnit?              @relation(fields: [orgUnitId], references: [id])
  AnnualPlanAllocation AnnualPlanAllocation? @relation(fields: [planAllocationId], references: [id])
  PlanningYear         PlanningYear          @relation(fields: [yearId], references: [id], onDelete: Cascade)
  BudgetLine           BudgetLine[]
  BudgetRequest        BudgetRequest[]
  FinanceEntry         FinanceEntry[]

  @@index([yearId, orgUnitId])
  @@index([currencyId], map: "idx_budget_currency")
}

model BudgetLine {
  id            Int            @id @default(autoincrement())
  budgetId      Int
  lineName      String
  plannedAmount Decimal        @default(0) @db.Decimal(18, 2)
  revisedAmount Decimal        @default(0) @db.Decimal(18, 2)
  currencyId    Int            @default(1) @map("currencyid")
  Budget        Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  currency      Currency       @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  FinanceEntry  FinanceEntry[]
}

model BudgetRequest {
  id              Int          @id @default(autoincrement())
  yearId          Int
  budgetId        Int?
  orgUnitId       Int?
  activityId      Int?
  requestDate     DateTime
  purpose         String
  requestedAmount Decimal      @default(0) @db.Decimal(18, 2)
  approvedAmount  Decimal      @default(0) @db.Decimal(18, 2)
  status          String       @default("draft")
  approvalStatus  String       @default("draft")
  requestedBy     Int?
  currencyId      Int          @default(1) @map("currencyid")
  Activity        Activity?    @relation(fields: [activityId], references: [id])
  Budget          Budget?      @relation(fields: [budgetId], references: [id])
  currency        Currency     @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrgUnit         OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  User            User?        @relation(fields: [requestedBy], references: [id])
  PlanningYear    PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model ComplianceFinding {
  id                    Int                   @id @default(autoincrement())
  requirementId         Int
  finding               String
  severity              String                @default("medium")
  recommendation        String?
  status                String                @default("open")
  ComplianceRequirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
}

model ComplianceRequirement {
  id                    Int                 @id @default(autoincrement())
  yearId                Int
  orgUnitId             Int?
  category              String?
  code                  String?
  title                 String
  authority             String?
  responsibleEmployeeId Int?
  dueDate               DateTime?
  status                String              @default("open")
  evidence              String?
  complianceTemplateId  Int?
  ComplianceFinding     ComplianceFinding[]
  ComplianceTemplate    ComplianceTemplate? @relation(fields: [complianceTemplateId], references: [id])
  OrgUnit               OrgUnit?            @relation(fields: [orgUnitId], references: [id])
  Employee              Employee?           @relation(fields: [responsibleEmployeeId], references: [id])
  PlanningYear          PlanningYear        @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@unique([title, yearId])
  @@index([complianceTemplateId])
}

model CorrectiveAction {
  id              Int          @id @default(autoincrement())
  yearId          Int
  sourceType      String
  sourceId        Int?
  ownerOrgUnitId  Int?
  ownerEmployeeId Int?
  title           String
  description     String?
  priority        String       @default("medium")
  dueDate         DateTime?
  status          String       @default("open")
  completion      Float        @default(0)
  Employee        Employee?    @relation(fields: [ownerEmployeeId], references: [id])
  OrgUnit         OrgUnit?     @relation(fields: [ownerOrgUnitId], references: [id])
  PlanningYear    PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model Employee {
  id                    Int                     @id @default(autoincrement())
  employeeNo            String?                 @unique
  fullName              String
  jobTitle              String?
  orgUnitId             Int?
  email                 String?
  phone                 String?
  active                Boolean                 @default(true)
  photoAttachmentId     Int?
  createdAt             DateTime                @default(now())
  Activity              Activity[]
  Asset                 Asset[]
  ComplianceRequirement ComplianceRequirement[]
  CorrectiveAction      CorrectiveAction[]
  OrgUnit               OrgUnit?                @relation(fields: [orgUnitId], references: [id])
  EmployeeEvaluation    EmployeeEvaluation[]
  EmployeePlan          EmployeePlan[]
  HrAction              HrAction[]
  KpiPlan               KpiPlan[]
  LegalMatter           LegalMatter[]
  Project               Project[]
  Risk                  Risk[]
  SubTask               SubTask[]
  TrainingParticipant   TrainingParticipant[]
  User                  User?
}

model EmployeeEvaluation {
  id                  Int               @id @default(autoincrement())
  yearId              Int
  employeeId          Int
  employeePlanId      Int?
  orgUnitId           Int?
  evaluatorId         Int?
  periodKey           String?
  planScore           Float             @default(0)
  executionScore      Float             @default(0)
  overallScore        Float             @default(0)
  status              String            @default("draft")
  approvalStatus      String            @default("draft")
  planNotes           String?
  executionNotes      String?
  strengths           String?
  areasForImprovement String?
  targetsNextPeriod   String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  Employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  EmployeePlan        EmployeePlan?     @relation(fields: [employeePlanId], references: [id])
  User                User?             @relation(fields: [evaluatorId], references: [id])
  OrgUnit             OrgUnit?          @relation(fields: [orgUnitId], references: [id])
  PlanningYear        PlanningYear      @relation(fields: [yearId], references: [id], onDelete: Cascade)
  EvaluationScore     EvaluationScore[]

  @@unique([yearId, employeeId, periodKey])
}

model EmployeePlan {
  id                   Int                    @id @default(autoincrement())
  yearId               Int
  employeeId           Int
  orgUnitId            Int?
  title                String
  status               String                 @default("draft")
  approvalStatus       String                 @default("draft")
  EmployeeEvaluation   EmployeeEvaluation[]
  Employee             Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  OrgUnit              OrgUnit?               @relation(fields: [orgUnitId], references: [id])
  PlanningYear         PlanningYear           @relation(fields: [yearId], references: [id], onDelete: Cascade)
  EmployeePlanActivity EmployeePlanActivity[]
  EmployeePlanKpi      EmployeePlanKpi[]

  @@unique([yearId, employeeId])
}

model EmployeePlanActivity {
  employeePlanId Int
  activityId     Int
  targetValue    Float?
  weight         Float        @default(1)
  Activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  EmployeePlan   EmployeePlan @relation(fields: [employeePlanId], references: [id], onDelete: Cascade)

  @@id([employeePlanId, activityId])
}

model EmployeePlanKpi {
  employeePlanId Int
  kpiPlanId      Int
  targetValue    Float?
  weight         Float        @default(1)
  EmployeePlan   EmployeePlan @relation(fields: [employeePlanId], references: [id], onDelete: Cascade)
  KpiPlan        KpiPlan      @relation(fields: [kpiPlanId], references: [id], onDelete: Cascade)

  @@id([employeePlanId, kpiPlanId])
}

model Evaluation {
  id              Int          @id @default(autoincrement())
  yearId          Int
  orgUnitId       Int?
  title           String
  evaluationType  String
  periodKey       String
  status          String       @default("draft")
  score           Float?
  findings        String?
  recommendations String?
  OrgUnit         OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  PlanningYear    PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model EvaluationCriterion {
  id              Int               @id @default(autoincrement())
  name            String
  description     String?
  weight          Float             @default(1)
  category        String            @default("general")
  active          Boolean           @default(true)
  sortOrder       Int               @default(0)
  EvaluationScore EvaluationScore[]

  @@unique([name, category])
}

model EvaluationScore {
  id                  Int                 @id @default(autoincrement())
  evaluationId        Int
  criterionId         Int
  score               Float
  comment             String?
  EvaluationCriterion EvaluationCriterion @relation(fields: [criterionId], references: [id])
  EmployeeEvaluation  EmployeeEvaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
}

model FinanceCategory {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  entryType    String
  code         String?
  description  String?
  active       Boolean        @default(true)
  FinanceEntry FinanceEntry[]
}

model FinanceEntry {
  id                                            Int              @id @default(autoincrement())
  yearId                                        Int
  orgUnitId                                     Int?
  branchOrgUnitId                               Int?
  budgetId                                      Int?
  budgetLineId                                  Int?
  categoryId                                    Int?
  reference                                     String?
  transactionDate                               DateTime
  entryType                                     String
  categoryName                                  String?
  amount                                        Decimal          @db.Decimal(18, 2)
  status                                        String           @default("draft")
  description                                   String?
  createdBy                                     Int?
  currencyId                                    Int              @default(1) @map("currencyid")
  OrgUnit_FinanceEntry_branchOrgUnitIdToOrgUnit OrgUnit?         @relation("FinanceEntry_branchOrgUnitIdToOrgUnit", fields: [branchOrgUnitId], references: [id])
  Budget                                        Budget?          @relation(fields: [budgetId], references: [id])
  BudgetLine                                    BudgetLine?      @relation(fields: [budgetLineId], references: [id])
  FinanceCategory                               FinanceCategory? @relation(fields: [categoryId], references: [id])
  User                                          User?            @relation(fields: [createdBy], references: [id])
  currency                                      Currency         @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrgUnit_FinanceEntry_orgUnitIdToOrgUnit       OrgUnit?         @relation("FinanceEntry_orgUnitIdToOrgUnit", fields: [orgUnitId], references: [id])
  PlanningYear                                  PlanningYear     @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@index([transactionDate, yearId, orgUnitId, branchOrgUnitId])
  @@index([currencyId], map: "idx_finance_entry_currency")
}

model Goal {
  id              Int              @id @default(autoincrement())
  yearId          Int
  resultId        Int?
  orgUnitId       Int?
  code            String?
  name            String
  description     String?
  weight          Float            @default(1)
  approvalStatus  String           @default("draft")
  OrgUnit         OrgUnit?         @relation(fields: [orgUnitId], references: [id])
  StrategicResult StrategicResult? @relation(fields: [resultId], references: [id])
  PlanningYear    PlanningYear     @relation(fields: [yearId], references: [id], onDelete: Cascade)
  Objective       Objective[]
}

model HrAction {
  id           Int          @id @default(autoincrement())
  yearId       Int
  actionType   String
  title        String
  employeeId   Int?
  orgUnitId    Int?
  targetValue  Float        @default(0)
  actualValue  Float        @default(0)
  status       String       @default("planned")
  notes        String?
  Employee     Employee?    @relation(fields: [employeeId], references: [id])
  OrgUnit      OrgUnit?     @relation(fields: [orgUnitId], references: [id])
  PlanningYear PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model Kpi {
  id          Int          @id @default(autoincrement())
  code        String?      @unique
  name        String
  area        String?
  definition  String?
  formula     String?
  unit        String?
  frequency   String       @default("quarterly")
  direction   String       @default("higher_is_better")
  active      Boolean      @default(true)
  categoryId  Int?
  KpiCategory KpiCategory? @relation(fields: [categoryId], references: [id])
  KpiPlan     KpiPlan[]
}

model KpiActual {
  id                               Int       @id @default(autoincrement())
  kpiPlanId                        Int
  periodType                       String
  periodKey                        String
  actualValue                      Float?
  comment                          String?
  evidence                         String?
  submittedBy                      Int?
  verifiedBy                       Int?
  approvalStatus                   String    @default("draft")
  submittedAt                      DateTime?
  verifiedAt                       DateTime?
  currencyid                       Int?
  Currency                         Currency? @relation(fields: [currencyid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  KpiPlan                          KpiPlan   @relation(fields: [kpiPlanId], references: [id], onDelete: Cascade)
  User_KpiActual_submittedByToUser User?     @relation("KpiActual_submittedByToUser", fields: [submittedBy], references: [id])
  User_KpiActual_verifiedByToUser  User?     @relation("KpiActual_verifiedByToUser", fields: [verifiedBy], references: [id])

  @@unique([kpiPlanId, periodType, periodKey])
}

model KpiCategory {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  active      Boolean       @default(true)
  Kpi         Kpi[]
  KpiTemplate KpiTemplate[]

  @@index([active])
}

model KpiPlan {
  id              Int               @id @default(autoincrement())
  yearId          Int
  kpiId           Int
  objectiveId     Int?
  orgUnitId       Int?
  ownerEmployeeId Int?
  baselineValue   Float?
  annualTarget    Float?
  q1Target        Float?
  q2Target        Float?
  q3Target        Float?
  q4Target        Float?
  weight          Float             @default(1)
  approvalStatus  String            @default("draft")
  kpiTemplateId   Int?
  currencyid      Int?
  EmployeePlanKpi EmployeePlanKpi[]
  KpiActual       KpiActual[]
  Currency        Currency?         @relation(fields: [currencyid], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Kpi             Kpi               @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  KpiTemplate     KpiTemplate?      @relation(fields: [kpiTemplateId], references: [id])
  Objective       Objective?        @relation(fields: [objectiveId], references: [id])
  OrgUnit         OrgUnit?          @relation(fields: [orgUnitId], references: [id])
  Employee        Employee?         @relation(fields: [ownerEmployeeId], references: [id])
  PlanningYear    PlanningYear      @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@unique([yearId, kpiId, orgUnitId])
  @@index([kpiTemplateId])
}

model LegalMatter {
  id                    Int          @id @default(autoincrement())
  yearId                Int
  matterType            String
  title                 String
  counterparty          String?
  value                 Decimal      @default(0) @db.Decimal(18, 2)
  responsibleEmployeeId Int?
  status                String       @default("open")
  nextAction            String?
  dueDate               DateTime?
  Employee              Employee?    @relation(fields: [responsibleEmployeeId], references: [id])
  PlanningYear          PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model ManagementAction {
  id             Int          @id @default(autoincrement())
  yearId         Int
  title          String
  description    String?
  ownerOrgUnitId Int?
  dueDate        DateTime?
  priority       String       @default("medium")
  status         String       @default("open")
  completion     Float        @default(0)
  createdBy      Int?
  User           User?        @relation(fields: [createdBy], references: [id])
  OrgUnit        OrgUnit?     @relation(fields: [ownerOrgUnitId], references: [id])
  PlanningYear   PlanningYear @relation(fields: [yearId], references: [id], onDelete: Cascade)
}

model ManagementReview {
  id              Int               @id @default(autoincrement())
  yearId          Int
  reviewPeriod    String
  reviewDate      DateTime
  participants    Json?
  status          String            @default("draft")
  notes           String?
  createdBy       Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  PlanningYear    PlanningYear      @relation(fields: [yearId], references: [id], onDelete: Cascade)
  User            User?             @relation(fields: [createdBy], references: [id])
  ReviewFinding   ReviewFinding[]
  ReviewDecision  ReviewDecision[]
  ReviewAction    ReviewAction[]

  @@index([yearId, status])
  @@index([yearId])
  @@index([status])
}

model ReviewFinding {
  id               Int              @id @default(autoincrement())
  reviewId         Int
  title            String
  description      String?
  severity         String           @default("medium")
  category         String           @default("kpi")
  sourceInfo       String?
  yearId           Int
  createdAt        DateTime         @default(now())
  ManagementReview ManagementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  PlanningYear     PlanningYear     @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([yearId])
  @@index([severity])
  @@index([category])
}

model ReviewDecision {
  id               Int               @id @default(autoincrement())
  reviewId         Int
  description      String?
  decision         String            @default("approved")
  dueDate          DateTime?
  assignedTo       Int?
  status           String            @default("open")
  createdAt        DateTime          @default(now())
  ManagementReview ManagementReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  User             User?             @relation(fields: [assignedTo], references: [id])

  @@index([reviewId])
  @@index([assignedTo])
