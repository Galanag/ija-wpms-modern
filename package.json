{
  "name": "ija-wpms",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm db:generate && concurrently -n WEB,API -c blue,green \"pnpm --filter @ija/web dev\" \"pnpm --filter @ija/api dev\"",
    "dev:web": "pnpm --filter @ija/web dev",
    "dev:api": "pnpm --filter @ija/api start:dev",
    "build": "pnpm db:generate && pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm db:generate && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ija/web test:e2e",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:format": "prisma format --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "legacy:inspect": "tsx scripts/inspect-legacy.ts",
    "legacy:import": "tsx scripts/import-legacy.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "prisma": "6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "argon2",
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "@prisma/client",
      "@scarf/scarf"
    ]
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  }
}
